{
  "functions": {
    "api/[route].js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "crons": [
    {
      "path": "/api/track?cron=1",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/track?cron=1&bench=1",
      "schedule": "50 6 * * *"
    },
    {
      "path": "/api/trends",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/monitor",
      "schedule": "40 * * * *"
    }
  ],
  "framework": "nextjs"
}
