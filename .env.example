# Maistro core — copy to .env for local development. Never commit .env.
# Full secret inventory: SECRETS.md (names only, kept current).

MAISTRO_ENV=local
MAISTRO_LOG_LEVEL=INFO

# Maistro's own Postgres (dedicated Supabase project — ADR D5)
MAISTRO_DATABASE_URL=

# Trend Radar (kymah.com) — agent key; read-only usage (ADR D9)
MAISTRO_TREND_RADAR_BASE_URL=https://kymah.com
MAISTRO_TREND_RADAR_AGENT_KEY=

# F1X8 (Modal)
MAISTRO_F1X8_BASE_URL=https://mohamedymay7--fixation-api-fastapi-app.modal.run
MAISTRO_F1X8_API_KEY=

# SamsungSentiment (Vercel deployment URL)
MAISTRO_SENTIMENT_BASE_URL=
MAISTRO_SENTIMENT_API_KEY=

# Lenceus banner-monitor
MAISTRO_LENCEUS_BASE_URL=http://localhost:4000
MAISTRO_LENCEUS_API_KEY=

# Publishing stays dry-run except prod — permanently (CONTRACTS.md §5)
MAISTRO_PUBLISH_DRY_RUN=true

# Operator REST auth (unset = open; local dev only)
MAISTRO_OPERATOR_API_KEY=

# MCP transport host allowlist (JSON list; set to the public hostname when deployed)
MAISTRO_MCP_ALLOWED_HOSTS=["localhost:8100", "127.0.0.1:8100"]

# Built-in daily monitoring scheduler
MAISTRO_SCHEDULER_ENABLED=true
MAISTRO_MONITORING_TICK_HOUR_UTC=6

# LangSmith graph tracing (LangGraph auto-instruments when these are set)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=maistro
